GITHUB_TOKEN=
OPENAI_API_KEY=
# GitHub 发布默认关闭；与只读 GITHUB_TOKEN 无凭据回退。仅支持可信本地单用户部署。
RIVU_GITHUB_PUBLISH_ENABLED=false
RIVU_GITHUB_PUBLISH_TOKEN=
# 本地操作口令，至少 32 字符；手动发布或启动时授权本次自动发布均使用此口令，不输入 GitHub PAT。
RIVU_PUBLICATION_API_TOKEN=
# GitHub 数字仓库 ID（逗号分隔），以及该 PAT 的 GitHub 用户数字 ID。
RIVU_GITHUB_PUBLISH_ALLOWED_REPOSITORIES=
# 启用时设置为正整数；留空时应删除或注释此行。
# RIVU_GITHUB_PUBLISH_PUBLISHER_ID=123456
# 在 GitHub 核对 Fine-grained PAT 的 Pull requests: write grant 后设为 true。
RIVU_GITHUB_PUBLISH_PULL_REQUESTS_WRITE_CONFIRMED=false
RIVU_GITHUB_PUBLISH_MAX_INLINE=30
RIVU_GITHUB_PUBLISH_BATCH_SIZE=15
OPENAI_BASE_URL=https://api.openai.com/v1
RIVU_MODEL=gpt-4.1-mini
RIVU_PROVIDER=openai
# DeepSeek 官方 OpenAI 兼容接口（下列示例替换上方三项；OPENAI_API_KEY 填 DeepSeek Key）：
# OPENAI_BASE_URL=https://api.deepseek.com
# RIVU_MODEL=deepseek-flash
# RIVU_PROVIDER=deepseek
# DeepSeek 默认开启推理；每个新任务冻结模式与强度，恢复不随环境配置变化。
RIVU_DEEPSEEK_THINKING=true
RIVU_DEEPSEEK_REASONING_EFFORT=high
# 服务商和模型必须支持原生工具调用；接口不支持时明确失败，不退回自研文本协议。
# 模型须支持原生 Tool Calling 与结构化提交。不强制 JSON mode。
RIVU_MODEL_REQUEST_TIMEOUT_SECONDS=60
# 单 Agent 模型调用熔断，quick/standard/deep 使用相同默认值；不是建议用满的调查配额。
RIVU_AGENT_MAX_CALLS=48
# Git 搜索/读取/解析仍受工具次数、扫描量和超时约束。
RIVU_AGENT_MAX_TOOL_CALLS=80
# DeepSeek 的此上限同时包含推理和最终输出；提高上限也会增加每次请求的预算预留。
RIVU_AGENT_OUTPUT_TOKENS=4096
# DeepSeek 大推理预算可将上项改为 125000；其他模型须先核对最大输出能力。
# RIVU_AGENT_OUTPUT_TOKENS=125000
RIVU_REVIEW_TIMEOUT_SECONDS=1800
# 默认期限每 3 个并发批次递增一次；明确填写的 timeout_seconds 不自动放大。
RIVU_REVIEW_SCALED_TIMEOUT_MAX_SECONDS=7200
# 首轮之后补查一次；有新源码/新候选才允许下一次。0 可关闭自动补查。
RIVU_REVIEW_GAP_FOLLOWUPS=2
RIVU_REVIEW_CONCURRENCY=4
# 整轮调用熔断；防止异常循环，不是建议用满的调查配额。
RIVU_REVIEW_MAX_MODEL_CALLS=
# 可选的整轮累计 Token 门禁；留空时仍记录用量，但不因累计 Token 收尾。
RIVU_REVIEW_MAX_INPUT_TOKENS=
RIVU_REVIEW_MAX_OUTPUT_TOKENS=
# 包含工具、Schema、输出和上下文的单次容量上限。
RIVU_MODEL_CONTEXT_TOKENS=1000000
RIVU_PR_DISCUSSIONS_ENABLED=true
RIVU_GIT_BIN=git
# 单次 Git clone/fetch/diff/checkout 的最大执行时间。
RIVU_GIT_TIMEOUT_SECONDS=900

# 只读审查不运行目标仓库代码。Webhooks 仅在 HMAC 与 allowlist 验证后启动。
RIVU_GITHUB_WEBHOOK_SECRET=
RIVU_INCREMENTAL_REVIEW_WEBHOOK_ENABLED=false
RIVU_INCREMENTAL_REVIEW_WEBHOOK_REPOSITORIES=
RIVU_INCREMENTAL_REVIEW_MAX_RUNS_PER_HOUR=4

# LangSmith 默认关闭；开启后仅上传运行 ID、计数、耗时及门禁状态。
# 消息和源码工具正文需单独明确开启；已知凭据脱敏不能保证识别所有源码秘密。
RIVU_LANGSMITH_TRACING=false
RIVU_LANGSMITH_CAPTURE_CONTENT=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rivu
# LANGSMITH_ENDPOINT=
RIVU_LANGSMITH_CONNECT_TIMEOUT_SECONDS=3
RIVU_LANGSMITH_READ_TIMEOUT_SECONDS=10

# 以下路径默认相对于 backend/ 目录，可覆盖为自定义路径
# RIVU_WORKDIR=backend/.rivu/workspaces
# 本地仓库由部署者显式注册；使用 JSON 对象与绝对路径，页面只显示键名。
# Windows 路径可使用正斜杠，例如 {"project":"D:/Code/project"}。
RIVU_LOCAL_REPOSITORIES={}
RIVU_LOCAL_INPUT_MAX_BYTES=1073741824
RIVU_LOCAL_INPUT_MAX_FILES=100000
# RIVU_DB_PATH=.rivu/reviews.db
# 任务队列使用数据库 claim/heartbeat/lease；服务启动前执行 `cd backend && uv run alembic upgrade head`。
RIVU_WORKER_POLL_SECONDS=0.25
RIVU_WORKER_LEASE_SECONDS=300
RIVU_WORKER_MAX_ATTEMPTS=3
# RIVU_ARTIFACT_DIR=backend/.rivu/artifacts
RIVU_RETENTION_DAYS=30
# 后台维护：过期审查、准备仓库与孤儿 workspace 回收
RIVU_MAINTENANCE_INTERVAL_SECONDS=3600
RIVU_ORPHAN_WORKSPACE_TTL_SECONDS=604800
# 预览准备仓库独立回收：有效命中续期，数量/总逻辑字节任一超限淘汰最久未使用项。
# 数量或字节上限设为 0 关闭磁盘复用；源码读取仍锁定双侧提交。
RIVU_PREPARED_WORKSPACE_TTL_SECONDS=3600
RIVU_PREPARED_WORKSPACE_MAX_ENTRIES=4
RIVU_PREPARED_WORKSPACE_MAX_BYTES=4294967296

# DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com
# RIVU_MODEL=deepseek-v4-pro
# RIVU_PROVIDER=deepseek
